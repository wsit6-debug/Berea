# Encrypted SHA-256 Hash of access password
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('your_password').digest('hex'))"
VITE_APP_PASSWORD_HASH=your_sha256_hash_here
# Optional: Official YouVersion Platform App Key from platform.youversion.com
VITE_YOUVERSION_APP_KEY=your_youversion_app_key_here
